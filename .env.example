# Set only when the production domain is confirmed.
# The build then emits canonical URLs, absolute social-image URLs, and sitemap.xml.
LANVEXA_SITE_URL=

# Optional public identity and contacts. Leave empty until approved.
LANVEXA_PUBLISHER_NAME=
LANVEXA_SUPPORT_EMAIL=
LANVEXA_SECURITY_EMAIL=
LANVEXA_PRIVACY_EMAIL=

# Enable only on the reviewed Netlify site after form detection and notifications are tested.
VITE_LANVEXA_ENABLE_BETA_FORM=false
